# Copy this file to .env and fill in your LLM API details.
# Any OpenAI-compatible endpoint works (OpenAI, Together, Groq, OpenRouter, local llama.cpp, etc.)

# Leave LLM_API_KEY empty to run in HEURISTIC mode (no LLM needed) - perfect for a quick demo.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Optional: backend/frontend ports
PORT=8787
FRONTEND_PORT=5173
